{
  "name": "@pocket-agent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pocket Agent backend API and WebSocket gateway.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "prisma generate && vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "test:integration": "prisma generate && vitest run -c vitest.integration.config.ts",
    "start:dev": "tsx --env-file-if-exists=.env src/server.ts",
    "db:new": "node scripts/new-migration.mjs"
  },
  "dependencies": {
    "@pocket-agent/core": "workspace:*",
    "@pocket-agent/protocol": "workspace:*",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.0",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/websocket": "11.3.6",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "5.12.8",
    "google-auth-library": "11.3.3",
    "ioredis": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@pocket-agent/config": "workspace:*",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "eslint": "10.14.0",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "ws": "8.22.1"
  }
}
