# Pocket Agent API configuration. Copy to .env for local development.
# Every value is validated at startup (src/env.ts). Never commit real values.

NODE_ENV=development
# 127.0.0.1 = this machine only. Use 0.0.0.0 to test from a phone on your LAN, and in containers.
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info

# Postgres (local default matches infrastructure/docker/docker-compose.yml)
DATABASE_URL=postgresql://pocket_agent:pocket_agent_dev_only@127.0.0.1:5432/pocket_agent

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Comma-separated list of browser origins allowed to call the API (CORS)
WEB_ORIGINS=http://localhost:3000

# Prefix for all Redis keys (lets several environments share one Redis)
REDIS_KEY_PREFIX=pocket-agent:

# Browser login sessions
SESSION_TTL_DAYS=30
# Secure cookies default to true in production; leave unset. Only plain-http local dev uses false.
# COOKIE_SECURE=false
# Parent domain when web and API are on sibling subdomains, e.g. .pocket-agent.example
# COOKIE_DOMAIN=

# Set false to close sign-ups (e.g. a self-hosted single-user install)
REGISTRATION_ENABLED=true

# Multiplies per-IP rate limits. Production may only tighten (<= 1).
RATE_LIMIT_SCALE=1

# Agent events older than this are deleted every 6 hours (audit logs are kept)
EVENT_RETENTION_DAYS=30

# Web push via Firebase Cloud Messaging (optional). Path to a service-account key JSON kept
# OUTSIDE the repository (it is a secret). Unset = notifications are in-app only.
# Firebase project for "Sign in with Google" (Firebase Auth ID tokens). Not a secret. Unset = off.
# FIREBASE_PROJECT_ID=pocket-agent27
# Photos and PDFs sent with messages (Cloudinary; kept 30 days). A secret. Unset = attachments off.
# CLOUDINARY_URL=cloudinary://<api key>:<api secret>@<cloud name>
# FCM_SERVICE_ACCOUNT_FILE=C:\Users\you\.pocket-agent-secrets\fcm-service-account.json
