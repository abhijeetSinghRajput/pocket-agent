{
  "name": "@agentdock/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgentDock web dashboard (desktop + mobile).",
  "scripts": {
    "dev": "next dev --webpack --port 3000",
    "build": "next build --webpack",
    "start": "next start --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
