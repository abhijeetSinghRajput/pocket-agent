{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pocket-agent-api.onrender.com",
        "GOOGLE_SERVICES_JSON": "./google-services.json"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://pocket-agent-api.onrender.com",
        "GOOGLE_SERVICES_JSON": "./google-services.json"
      }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "POCKET_AGENT_ALLOW_HTTP": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
