{
  "name": "pocket-agent",
  "private": true,
  "description": "Pocket Agent — remote command center for AI coding agents running on your own machines.",
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/**\" build",
    "build": "pnpm build:packages && pnpm --filter \"./apps/**\" build",
    "dev:api": "pnpm build:packages && pnpm --filter @pocket-agent/api dev",
    "dev:web": "pnpm build:packages && pnpm --filter @pocket-agent/web dev",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm build:packages && pnpm -r test",
    "test:e2e": "pnpm build:packages && pnpm --filter @pocket-agent/local-agent build && pnpm --filter @pocket-agent/web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test",
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "db:migrate": "pnpm --filter @pocket-agent/api db:migrate",
    "test:integration": "pnpm build:packages && pnpm --filter @pocket-agent/api test:integration",
    "pocket-agent": "node apps/local-agent/dist/cli.js"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
