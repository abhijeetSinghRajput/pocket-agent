// Pocket Agent data model. Postgres is the source of truth; Redis holds only transient state.
// Enum values mirror packages/protocol/src/enums.ts (checked by test/schema-sync.test.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  windows
  macos
  linux
}

enum DeviceStatus {
  Online
  Offline
  Revoked
}

enum SessionMode {
  managed
  observed
}

enum AgentStatus {
  Starting
  Running
  WaitingForInput
  WaitingForPermission
  Completed
  Failed
  Stopped
  Disconnected
}

enum CommandStatus {
  Pending
  Delivered
  Accepted
  Executing
  Completed
  Failed
  Expired
}

enum ApprovalStatus {
  Pending
  Approved
  Denied
  Expired
  Cancelled
}

enum ActorType {
  user
  device
  system
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  /// Stored lower-cased; uniqueness is case-insensitive by construction.
  email        String   @unique
  /// Null for accounts that only sign in with Google.
  passwordHash String?
  /// Firebase Auth user id of the linked Google account.
  googleUid    String?  @unique
  /// Google profile photo (https), shown as the avatar.
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  authSessions         AuthSession[]
  pairingCodes         PairingCode[]
  pairingRequests      PairingRequest[]
  devices              Device[]
  commands             Command[]
  approvals            Approval[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  notificationSettings NotificationSettings?
  attachments          Attachment[]
  pushSubscriptions    PushSubscription[]
  auditLogs            AuditLog[]

  @@map("users")
}

/// Browser login session. Only a hash of the cookie token is stored.
model AuthSession {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

/// Short-lived, single-use code used to pair a PC. Only the hash is stored.
model PairingCode {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  codeHash   String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  consumedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("pairing_codes")
}

/// A PC asking to be paired with a QR code: it shows the link, you approve it on your phone, and
/// the PC (holding the poll token) then collects its credentials once.
model PairingRequest {
  /// Random (v4): it is in the QR code and the link.
  id            String    @id @default(uuid(4)) @db.Uuid
  /// sha256 of the token only the PC has; it alone can collect the credentials.
  pollTokenHash String    @unique
  /// Shown on the PC and on the phone, so you can tell it is the same request.
  check         String
  name          String
  platform      Platform
  agentVersion  String
  createdAt     DateTime  @default(now())
  expiresAt     DateTime
  /// Who approved it (set on approve).
  userId        String?   @db.Uuid
  approvedAt    DateTime?
  declinedAt    DateTime?
  /// The PC collected its credentials: the request is used up.
  consumedAt    DateTime?
  deviceId      String?   @db.Uuid

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("pairing_requests")
}

model Device {
  id                    String       @id @default(uuid(7)) @db.Uuid
  userId                String       @db.Uuid
  name                  String
  platform              Platform
  agentVersion          String
  status                DeviceStatus @default(Offline)
  /// sha256 of the high-entropy device secret; the secret itself is never stored.
  secretHash            String       @unique
  /// Two-phase rotation: a newly issued secret becomes current the first time the agent
  /// authenticates with it; until then the old secret keeps working (no lock-out on a lost response).
  pendingSecretHash     String?      @unique
  /// Remote approval is opt-in per device (architecture: Approved constraints #3).
  remoteApprovalEnabled Boolean      @default(false)
  awayMode              Boolean      @default(true)
  /// Reported by the PC (device.settings), which also enforces them. Display-only on the server.
  projects              Json         @default("[]")
  /// Models the PC's Claude Code offers ([{id,name,description}]), as reported by the PC.
  models                Json         @default("[]")
  /// Claude plan usage reported by the PC ({session, weekly, models, updatedAt}), or null.
  usage                 Json?
  observedInstructions  Boolean      @default(false)
  /// The PC's own setup checks ({hooks}), reported by PCs from 2.0.0 (the app's health check).
  health                Json?
  lastHeartbeatAt       DateTime?
  revokedAt             DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions  AgentSession[]
  events    AgentEvent[]
  approvals Approval[]
  commands  Command[]

  @@index([userId])
  @@map("devices")
}

model AgentSession {
  id                String      @id @default(uuid(7)) @db.Uuid
  deviceId          String      @db.Uuid
  /// Provider id from packages/protocol (e.g. "claude-code").
  provider          String
  mode              SessionMode
  externalSessionId String
  projectName       String
  projectPath       String
  status            AgentStatus @default(Starting)
  /// SessionCapabilities from packages/protocol.
  capabilities      Json
  /// Provider-specific metadata.
  metadata          Json?
  currentTask       String?
  startedAt         DateTime    @default(now())
  lastActivityAt    DateTime    @default(now())
  endedAt           DateTime?

  device    Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  events    AgentEvent[]
  commands  Command[]
  approvals Approval[]

  /// Reconnects must not create duplicate sessions.
  @@unique([deviceId, externalSessionId])
  @@index([deviceId, status])
  @@map("agent_sessions")
}

/// Append-only activity log of agent events. eventId is the protocol dedupe key.
/// Retention: payloads older than 30 days are pruned (job added in M3).
model AgentEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  eventId   String   @unique @db.Uuid
  deviceId  String   @db.Uuid
  sessionId String?  @db.Uuid
  eventType String
  payload   Json
  createdAt DateTime @default(now())

  device  Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  session AgentSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@index([deviceId, createdAt])
  @@index([createdAt])
  @@map("agent_events")
}

model Command {
  id             String        @id @default(uuid(7)) @db.Uuid
  deviceId       String        @db.Uuid
  /// Null for session.start until the PC reports the new session.
  sessionId      String?       @db.Uuid
  userId         String        @db.Uuid
  commandType    String
  payload        Json
  status         CommandStatus @default(Pending)
  /// Client-supplied; makes retries safe.
  idempotencyKey String
  error          String?
  createdAt      DateTime      @default(now())
  deliveredAt    DateTime?
  completedAt    DateTime?
  expiresAt      DateTime

  device  Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  session AgentSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([sessionId, createdAt])
  @@index([deviceId, status])
  @@index([status, expiresAt])
  @@map("commands")
}

/// A permission request bound to one user, device, session and request (tool_use_id).
model Approval {
  id              String         @id @default(uuid(7)) @db.Uuid
  sessionId       String         @db.Uuid
  deviceId        String         @db.Uuid
  userId          String         @db.Uuid
  /// Provider request id (Claude Code tool_use_id).
  requestId       String
  toolName        String
  requestPayload  Json
  status          ApprovalStatus @default(Pending)
  /// "allow" | "deny", set once (compare-and-set). Status becomes Approved/Denied only after the PC
  /// confirms it applied the decision; Cancelled if it arrived too late.
  decision        String?
  decisionMessage String?
  decidedByUserId String?        @db.Uuid
  createdAt       DateTime       @default(now())
  expiresAt       DateTime
  decidedAt       DateTime?

  session AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  device  Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, requestId])
  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("approvals")
}

model Notification {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @db.Uuid
  type        String
  priority    String
  title       String
  body        String
  /// Deep-link target etc.
  data        Json?
  /// Prevents duplicate notifications for the same underlying event.
  dedupeKey   String?
  readAt      DateTime?
  /// Push outcome, shown in history: browsers it was sent to, or why it was not pushed.
  pushSent    Int       @default(0)
  pushSkipped String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id       String  @id @default(uuid(7)) @db.Uuid
  userId   String  @db.Uuid
  category String
  enabled  Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("notification_preferences")
}

/// Quiet hours (only critical pushes go out; everything is still recorded).
model NotificationSettings {
  userId     String  @id @db.Uuid
  quietStart String?
  quietEnd   String?
  timezone   String  @default("UTC")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

model PushSubscription {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  platform   String
  token      String    @unique
  userAgent  String?
  lastError  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// Append-only security audit trail: approval decisions, setting changes, pairing, revocation.
/// The application never updates or deletes rows here.
/// A photo or PDF sent with a message. The file lives in Cloudinary for 30 days; `thumb` (a small
/// JPEG) stays so the chat can still show a preview afterwards.
model Attachment {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @db.Uuid
  /// The PC that uploaded it (a file attached in the editor); null when sent from the app.
  deviceId  String?   @db.Uuid
  name      String
  mime      String
  size      Int
  /// Storage id (random; never derived from the name).
  publicId  String    @unique
  /// Set once storage confirmed the upload; null = reserved, not uploaded yet.
  readyAt   DateTime?
  thumb     Bytes?
  createdAt DateTime  @default(now())
  /// Set when the file was deleted from storage (the preview remains).
  removedAt DateTime?
  /// Set when a message carried it. Uploads that never get sent are deleted after an hour.
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([removedAt, createdAt])
  @@map("attachments")
}

model AuditLog {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @db.Uuid
  actorType  ActorType
  actorId    String?
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}
