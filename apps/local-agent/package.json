{
  "name": "@pocket-agent/local-agent",
  "version": "2.15.1",
  "private": true,
  "type": "module",
  "description": "Pocket Agent Local Agent: runs on the user's PC and connects outbound to the Pocket Agent API.",
  "bin": {
    "pocket-agent": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "pack:npm": "node scripts/pack-npm.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@pocket-agent/protocol": "workspace:*",
    "commander": "15.0.0",
    "qrcode": "1.5.4",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@pocket-agent/config": "workspace:*",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.7"
  }
}
