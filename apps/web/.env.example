# Public base URL of the Pocket Agent API (apps/api). Exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Web push (optional). Firebase web app config + the Web Push certificate (VAPID public key).
# Without these, notifications still appear in the app; push stays off.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Google sign-in (Firebase Auth). Defaults to <project id>.firebaseapp.com.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Deployment behind a proxy (e.g. Vercel → Render). Leave unset for local development.
#   NEXT_PUBLIC_API_URL=/api                                   (calls go through this site)
#   API_PROXY_TARGET=https://pocket-agent-api.onrender.com       (server-side, where /api forwards)
#   NEXT_PUBLIC_WS_URL=wss://pocket-agent-api.onrender.com/ws/client
#   NEXT_PUBLIC_AGENT_API_URL=https://pocket-agent-api.onrender.com   (shown in the pairing command)
