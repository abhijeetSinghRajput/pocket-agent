{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@pocket-agent/protocol": ["../../packages/protocol/src/index.ts"],
      "@pocket-agent/core": ["../../packages/core/src/index.ts"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "app.config.ts", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
