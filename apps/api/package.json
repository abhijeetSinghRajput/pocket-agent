{
  "name": "@agentdock/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgentDock backend API and WebSocket gateway.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "prisma generate && vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "test:integration": "prisma generate && vitest run -c vitest.integration.config.ts",
    "start:dev": "tsx --env-file-if-exists=.env src/server.ts"
  },
  "dependencies": {
    "@agentdock/protocol": "workspace:*",
    "@fastify/cors": "11.4.0",
    "@fastify/helmet": "13.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "5.12.8",
    "ioredis": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@agentdock/config": "workspace:*",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
