# Public base URL of the AgentDock API (apps/api). Exposed to the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Web push (optional). Firebase web app config + the Web Push certificate (VAPID public key).
# Without these, notifications still appear in the app; push stays off.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
